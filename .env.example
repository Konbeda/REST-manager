PORT=3000

# Atlas: pegue em Database > Connect > Drivers e troque <db_password> pela senha real.
# Local:  mongodb://127.0.0.1:27017/rest-manager
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/rest-manager?retryWrites=true&w=majority

# Chave de assinatura dos JWT. NUNCA comite o valor real.
# Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-32-bytes-aleatorios-em-hex

# Quantos proxies confiáveis existem à frente da aplicação.
# 0 = nenhum (padrão seguro): o X-Forwarded-For é ignorado.
# 1 = um proxy reverso (nginx, ALB). 2 = Cloudflare + ALB. E assim por diante.
# Confiar no cabeçalho sem proxy real permite forjar o IP e burlar o rate limit.
TRUST_PROXY=0

# Rate limiting (opcionais — os padrões abaixo já valem)
# RATE_LIMIT_WINDOW_MS=900000   # janela do limite por IP (15 min)
# RATE_LIMIT_AUTH_MAX=30        # requisições por IP em /api/auth por janela
# LOGIN_MAX_FALHAS=5            # falhas de login por CONTA antes de bloquear
# LOGIN_JANELA_MS=900000        # janela do bloqueio por conta (15 min)

# Encerramento gracioso (opcionais)
# A SOMA dos dois precisa caber no prazo do supervisor: docker stop (--time),
# ou terminationGracePeriodSeconds no Kubernetes. Estourar = SIGKILL no meio.
# SHUTDOWN_ESPERA_LB_MS=3000    # espera até o balanceador notar o /ready 503
# SHUTDOWN_PRAZO_MS=10000       # prazo máximo de drenagem
