PORT=3000

# Atlas: pegue em Database > Connect > Drivers e troque <db_password> pela senha real.
# Local:  mongodb://127.0.0.1:27017/rest-manager
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/rest-manager?retryWrites=true&w=majority

# Chave de assinatura dos JWT. NUNCA comite o valor real.
# Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-32-bytes-aleatorios-em-hex
